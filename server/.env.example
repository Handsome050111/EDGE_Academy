PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/edge-academy?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.vercel.app
# SMTP Configuration (Recommended for one.com Webmail)
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=academy@technonex.de
SMTP_PASS=your_onecom_email_password_here
SMTP_FROM=EDGE Academy <academy@technonex.de>

# Optional Resend API Alternative
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=EDGE Academy <onboarding@mail.technonex.de>
